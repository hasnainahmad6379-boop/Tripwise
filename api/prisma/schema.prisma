datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}
model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  trips    Trip[]
  creditLedger CreditLedger[]
}
model Trip{
    id              Int         @id  @default(autoincrement())
    destination     String
    startDate       DateTime
    endDate         DateTime
    budget          Float
    interests       String
    userId          Int
    user            User        @relation(fields: [userId], references: [id])  
    itineraryDays   ItineraryDay[]
}
model ItineraryDay {
    id          Int         @id @default(autoincrement())
    tripId      Int
    dayNumber   Int
    date        DateTime
    title       String
    activities  Json
    dailyEstimatedCost Float   @default(0)
    weather     Json?
    trip        Trip        @relation(fields:[tripId],references:[id],onDelete: Cascade)
}
model CreditLedger {
    id          Int         @id @default(autoincrement())
    userId      Int
    amount      Int
    stripeSessionId String?  @unique
    type        String
    createdAt   DateTime    @default(now())
    user        User        @relation(fields: [userId], references: [id])
}